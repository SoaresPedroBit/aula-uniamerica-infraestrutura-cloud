              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "p95 ${metric.labels.operation}",
                "minAlignmentPeriod": "300s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "groupByFields": [
                        "metric.labels.operation"
                      ],
                      "perSeriesAligner": "ALIGN_PERCENTILE_95"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/app_request_duration_ms\" resource.type=\"cloud_run_revision\""
